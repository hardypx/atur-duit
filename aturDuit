            { id: 11, tanggal: "2026-01-18", kategori: "Kesehatan", tipe: "Pengeluaran", deskripsi: "Beli Obat", jumlah: 85000, metode: "Cash" },
            { id: 12, tanggal: "2026-01-20", kategori: "Tabungan", tipe: "Pengeluaran", deskripsi: "Transfer ke Tabungan", jumlah: 2000000, metode: "Transfer Bank" },
            { id: 13, tanggal: "2026-01-22", kategori: "Makan", tipe: "Pengeluaran", deskripsi: "Makan Siang", jumlah: 45000, metode: "Cash" },
            { id: 14, tanggal: "2026-01-25", kategori: "Tagihan", tipe: "Pengeluaran", deskripsi: "Internet WiFi", jumlah: 300000, metode: "Transfer Bank" },
            { id: 15, tanggal: "2026-01-28", kategori: "Belanja", tipe: "Pengeluaran", deskripsi: "Beli Baju", jumlah: 275000, metode: "e-Wallet" },
        ];

        let budgetConfig = JSON.parse(localStorage.getItem('fintrack_budget')) || {
            "Makan": 2000000,
            "Transportasi": 500000,
            "Belanja": 1500000,
            "Tagihan": 1000000,
            "Hiburan": 500000,
            "Kesehatan": 300000,
            "Tabungan": 2000000,
            "Lainnya": 500000
        };

        let transaksi = JSON.parse(localStorage.getItem('fintrack_data')) || defaultData;
        let pieChart, barChart;

        // ==================== UTILS ====================
        function formatRupiah(num) {
            return 'Rp ' + num.toLocaleString('id-ID');
        }

        function formatTanggal(str) {
            const d = new Date(str);
            return d.toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' });
        }

        function getBulanTahun(str) {
            const d = new Date(str);
            return { bulan: d.getMonth(), tahun: d.getFullYear(), label: d.toLocaleDateString('id-ID', { month: 'long', year: 'numeric' }) };
        }

        function saveData() {
            localStorage.setItem('fintrack_data', JSON.stringify(transaksi));
        }

        function showToast(msg) {
            const toast = document.getElementById('toast');
            document.getElementById('toast-msg').textContent = msg;
            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => toast.classList.add('translate-y-20', 'opacity-0'), 2500);
        }

        // ==================== NAVIGATION ====================
        function showPage(page) {
            document.querySelectorAll('.page').forEach(p => p.classList.add('hidden'));
            document.getElementById('page-' + page).classList.remove('hidden');

            document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
            const nav = document.getElementById('nav-' + page);
            if (nav) nav.classList.add('active');

            document.getElementById('mobile-menu').classList.add('hidden');
            window.scrollTo(0, 0);

            if (page === 'dashboard') updateDashboard();
            if (page === 'transaksi') { populateFilterBulan(); renderTransaksi(); }
            if (page === 'rekap') renderRekap();
            if (page === 'anggaran') renderAnggaran();
        }

        function toggleMobileMenu() {
            document.getElementById('mobile-menu').classList.toggle('hidden');
        }

        // ==================== DASHBOARD ====================
        function updateDashboard() {
            const now = new Date();
            const currentMonth = now.getMonth();
            const currentYear = now.getFullYear();

            let income = 0, expense = 0;
            transaksi.forEach(t => {
                const d = new Date(t.tanggal);
                if (d.getMonth() === currentMonth && d.getFullYear() === currentYear) {
                    if (t.tipe === 'Pemasukan') income += t.jumlah;
                    else expense += t.jumlah;
                }
            });

            document.getElementById('dash-income').textContent = formatRupiah(income);
            document.getElementById('dash-expense').textContent = formatRupiah(expense);
            document.getElementById('dash-netto').textContent = formatRupiah(income - expense);
            document.getElementById('dash-status').textContent = income - expense >= 0 ? 'Surplus' : 'Defisit';
            document.getElementById('dash-status').className = `text-xs font-semibold px-2 py-1 rounded-full ${income - expense >= 0 ? 'text-income-600 bg-income-50' : 'text-expense-600 bg-expense-50'}`;

            // Pie Chart
            const kategoriData = {};
            transaksi.filter(t => t.tipe === 'Pengeluaran').forEach(t => {
                kategoriData[t.kategori] = (kategoriData[t.kategori] || 0) + t.jumlah;
            });

            const pieCtx = document.getElementById('chart-pie').getContext('2d');
            if (pieChart) pieChart.destroy();
            pieChart = new Chart(pieCtx, {
                type: 'doughnut',
                data: {
                    labels: Object.keys(kategoriData),
                    datasets: [{
                        data: Object.values(kategoriData),
                        backgroundColor: ['#3b82f6', '#ef4444', '#f59e0b', '#10b981', '#8b5cf6', '#ec4899', '#06b6d4', '#84cc16'],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'right', labels: { usePointStyle: true, padding: 15, font: { size: 11 } } }
                    },
                    cutout: '65%'
                }
            });

            // Bar Chart
            const monthlyData = {};
            for (let i = 0; i < 6; i++) {
                const d = new Date(currentYear, currentMonth - 5 + i, 1);
                const key = d.toLocaleDateString('id-ID', { month: 'short', year: 'numeric' });
                monthlyData[key] = { income: 0, expense: 0 };
            }
            transaksi.forEach(t => {
                const d = new Date(t.tanggal);
                const key = d.toLocaleDateString('id-ID', { month: 'short', year: 'numeric' });
                if (monthlyData[key]) {
                    if (t.tipe === 'Pemasukan') monthlyData[key].income += t.jumlah;
                    else monthlyData[key].expense += t.jumlah;
                }
            });

            const barCtx = document.getElementById('chart-bar').getContext('2d');
            if (barChart) barChart.destroy();
            barChart = new Chart(barCtx, {
                type: 'bar',
                data: {
                    labels: Object.keys(monthlyData),
                    datasets: [
                        { label: 'Pemasukan', data: Object.values(monthlyData).map(d => d.income), backgroundColor: '#22c55e', borderRadius: 6 },
                        { label: 'Pengeluaran', data: Object.values(monthlyData).map(d => d.expense), backgroundColor: '#ef4444', borderRadius: 6 }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'top', labels: { usePointStyle: true } } },
                    scales: {
                        y: { beginAtZero: true, grid: { color: '#f1f5f9' }, ticks: { callback: v => 'Rp ' + (v/1000000).toFixed(1) + 'M' } },
                        x: { grid: { display: false } }
                    }
                }
            });

            // Recent transactions
            const recent = [...transaksi].sort((a, b) => new Date(b.tanggal) - new Date(a.tanggal)).slice(0, 5);
            const tbody = document.getElementById('recent-table');
            tbody.innerHTML = recent.map(t => `
                <tr class="hover:bg-slate-50 transition-colors">
                    <td class="px-6 py-4 text-sm text-slate-600">${formatTanggal(t.tanggal)}</td>
                    <td class="px-6 py-4"><span class="px-2 py-1 rounded-lg text-xs font-medium ${t.tipe === 'Pemasukan' ? 'bg-income-100 text-income-600' : 'bg-expense-100 text-expense-600'}">${t.kategori}</span></td>
                    <td class="px-6 py-4 text-sm text-slate-700">${t.deskripsi}</td>
                    <td class="px-6 py-4 text-sm font-semibold text-right ${t.tipe === 'Pemasukan' ? 'text-income-600' : 'text-expense-600'}">${t.tipe === 'Pemasukan' ? '+' : '-'} ${formatRupiah(t.jumlah)}</td>
                </tr>
            `).join('');
        }

        // ==================== TRANSAKSI ====================
        function populateFilterBulan() {
            const select = document.getElementById('filter-bulan');
            const months = [...new Set(transaksi.map(t => {
                const d = new Date(t.tanggal);
                return d.toLocaleDateString('id-ID', { month: 'long', year: 'numeric' });
            }))].sort();
            select.innerHTML = '<option value="">Semua Bulan</option>' + months.map(m => `<option value="${m}">${m}</option>`).join('');
        }

        function renderTransaksi() {
            const filterTipe = document.getElementById('filter-tipe').value;
            const filterBulan = document.getElementById('filter-bulan').value;

            let data = [...transaksi].sort((a, b) => new Date(b.tanggal) - new Date(a.tanggal));
            if (filterTipe) data = data.filter(t => t.tipe === filterTipe);
            if (filterBulan) data = data.filter(t => {
                const d = new Date(t.tanggal);
                return d.toLocaleDateString('id-ID', { month: 'long', year: 'numeric' }) === filterBulan;
            });

            const tbody = document.getElementById('transaksi-table');
            const empty = document.getElementById('empty-state');

            if (data.length === 0) {
                tbody.innerHTML = '';
                empty.classList.remove('hidden');
                return;
            }
            empty.classList.add('hidden');

            tbody.innerHTML = data.map((t, i) => `
                <tr class="hover:bg-slate-50 transition-colors">
                    <td class="px-6 py-4 text-sm text-slate-500">${i + 1}</td>
                    <td class="px-6 py-4 text-sm text-slate-600">${formatTanggal(t.tanggal)}</td>
                    <td class="px-6 py-4"><span class="px-2 py-1 rounded-lg text-xs font-medium bg-slate-100 text-slate-600">${t.kategori}</span></td>
                    <td class="px-6 py-4"><span class="px-2 py-1 rounded-lg text-xs font-medium ${t.tipe === 'Pemasukan' ? 'bg-income-100 text-income-600' : 'bg-expense-100 text-expense-600'}">${t.tipe}</span></td>
                    <td class="px-6 py-4 text-sm text-slate-700">${t.deskripsi}</td>
                    <td class="px-6 py-4 text-sm font-semibold text-right ${t.tipe === 'Pemasukan' ? 'text-income-600' : 'text-expense-600'}">${formatRupiah(t.jumlah)}</td>
                    <td class="px-6 py-4 text-center">
                        <button onclick="deleteTransaksi(${t.id})" class="text-expense-500 hover:text-expense-700 transition-colors p-2 rounded-lg hover:bg-expense-50">
                            <i class="fas fa-trash-alt"></i>
                        </button>
                    </td>
                </tr>
            `).join('');
        }

        function addTransaction(e) {
            e.preventDefault();
            const newTx = {
                id: Date.now(),
                tanggal: document.getElementById('tgl').value,
                kategori: document.getElementById('kategori').value,
                tipe: document.getElementById('tipe').value,
                deskripsi: document.getElementById('deskripsi').value,
                jumlah: parseInt(document.getElementById('jumlah').value),
                metode: document.getElementById('metode').value
            };
            transaksi.push(newTx);
            saveData();
            document.getElementById('form-transaksi').reset();
            document.getElementById('tgl').valueAsDate = new Date();
            renderTransaksi();
            showToast('Transaksi berhasil ditambahkan!');
        }

        function deleteTransaksi(id) {
            if (confirm('Hapus transaksi ini?')) {
                transaksi = transaksi.filter(t => t.id !== id);
                saveData();
                renderTransaksi();
                showToast('Transaksi dihapus');
            }
        }

        // ==================== REKAP ====================
        function renderRekap() {
            const periods = {};
            transaksi.forEach(t => {
                const info = getBulanTahun(t.tanggal);
                const key = info.label;
                if (!periods[key]) periods[key] = { income: 0, expense: 0, label: key };
                if (t.tipe === 'Pemasukan') periods[key].income += t.jumlah;
                else periods[key].expense += t.jumlah;
            });

            const sorted = Object.values(periods).sort((a, b) => {
                const months = ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];
                const [ma, ya] = a.label.split(' ');
                const [mb, yb] = b.label.split(' ');
                if (ya !== yb) return parseInt(ya) - parseInt(yb);
                return months.indexOf(ma) - months.indexOf(mb);
            });

            const tbody = document.getElementById('rekap-table');
            tbody.innerHTML = sorted.map(p => {
                const netto = p.income - p.expense;
                return `
                    <tr class="hover:bg-slate-50 transition-colors">
                        <td class="px-6 py-4 font-medium text-slate-900">${p.label}</td>
                        <td class="px-6 py-4 text-sm font-semibold text-income-600 text-right">${formatRupiah(p.income)}</td>
                        <td class="px-6 py-4 text-sm font-semibold text-expense-600 text-right">${formatRupiah(p.expense)}</td>
                        <td class="px-6 py-4 text-sm font-bold text-right ${netto >= 0 ? 'text-income-600' : 'text-expense-600'}">${formatRupiah(netto)}</td>
                        <td class="px-6 py-4 text-center">
                            <span class="px-3 py-1 rounded-full text-xs font-semibold ${netto > 0 ? 'bg-income-100 text-income-600' : netto < 0 ? 'bg-expense-100 text-expense-600' : 'bg-slate-100 text-slate-600'}">
                                ${netto > 0 ? 'Surplus' : netto < 0 ? 'Defisit' : 'Break Even'}
                            </span>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        // ==================== ANGGARAN ====================
        function renderAnggaran() {
            const realisasi = {};
            transaksi.filter(t => t.tipe === 'Pengeluaran').forEach(t => {
                realisasi[t.kategori] = (realisasi[t.kategori] || 0) + t.jumlah;
            });

            let totalAnggaran = 0, totalRealisasi = 0;
            const list = document.getElementById('anggaran-list');

            list.innerHTML = Object.entries(budgetConfig).map(([kat, anggaran]) => {
                const real = realisasi[kat] || 0;
                const sisa = anggaran - real;
                const persen = anggaran > 0 ? Math.min((real / anggaran) * 100, 100) : 0;
                totalAnggaran += anggaran;
                totalRealisasi += real;

                let barColor = 'bg-blue-500';
                let statusColor = 'text-income-600';
                let statusText = 'Aman';
                if (persen > 80) { barColor = 'bg-amber-500'; statusColor = 'text-amber-600'; statusText = 'Hati-hati'; }
                if (persen >= 100) { barColor = 'bg-expense-500'; statusColor = 'text-expense-600'; statusText = 'Over Budget'; }

                return `
                    <div class="p-6 hover:bg-slate-50 transition-colors group">
                        <div class="flex justify-between items-start mb-3">
                            <div class="flex-1">
                                <div class="flex items-center gap-2">
                                    <h4 class="font-semibold text-slate-900">${kat}</h4>
                                    <button onclick="openEditAnggaran('${kat}', ${anggaran})" class="opacity-0 group-hover:opacity-100 transition-opacity text-slate-400 hover:text-blue-600 p-1 rounded-lg hover:bg-blue-50" title="Edit anggaran">
                                        <i class="fas fa-pencil-alt text-sm"></i>
                                    </button>
                                </div>
                                <p class="text-sm text-slate-500 mt-0.5">Anggaran: ${formatRupiah(anggaran)} | Realisasi: ${formatRupiah(real)}</p>
                            </div>
                            <span class="text-sm font-semibold ${statusColor}">${statusText}</span>
                        </div>
                        <div class="w-full bg-slate-100 rounded-full h-3 mb-2">
                            <div class="${barColor} h-3 rounded-full progress-bar" style="width: ${persen}%"></div>
                        </div>
                        <div class="flex justify-between text-xs text-slate-500">
                            <span>${persen.toFixed(1)}% tercapai</span>
                            <span class="${sisa >= 0 ? 'text-income-600' : 'text-expense-600'} font-medium">Sisa: ${formatRupiah(sisa)}</span>
                        </div>
                    </div>
                `;
            }).join('');

            document.getElementById('total-anggaran').textContent = formatRupiah(totalAnggaran);
            document.getElementById('total-realisasi').textContent = formatRupiah(totalRealisasi);
            document.getElementById('total-sisa').textContent = formatRupiah(totalAnggaran - totalRealisasi);
        }

        // ==================== MODAL ANGGARAN ====================
        let editingKategori = '';

        function openEditAnggaran(kategori, nominal) {
            editingKategori = kategori;
            document.getElementById('edit-kat').value = kategori;
            document.getElementById('edit-nominal').value = nominal;
            document.getElementById('modal-anggaran').classList.remove('hidden');
            setTimeout(() => document.getElementById('edit-nominal').focus(), 100);
        }

        function closeModalAnggaran() {
            document.getElementById('modal-anggaran').classList.add('hidden');
            editingKategori = '';
        }

        function saveAnggaran() {
            const nominal = parseInt(document.getElementById('edit-nominal').value);
            if (!nominal || nominal < 0) {
                alert('Masukkan nominal yang valid');
                return;
            }
            budgetConfig[editingKategori] = nominal;
            localStorage.setItem('fintrack_budget', JSON.stringify(budgetConfig));
            closeModalAnggaran();
            renderAnggaran();
            showToast(`Anggaran ${editingKategori} diperbarui!`);
        }

        // Close modal on Escape key
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeModalAnggaran();
        });

// ==================== INIT ====================
        document.getElementById('tgl').valueAsDate = new Date();
        showPage('dashboard');
    </script>

    <!-- Modal Edit Anggaran -->
    <div id="modal-anggaran" class="fixed inset-0 z-50 hidden">
        <div class="absolute inset-0 bg-black/40 backdrop-blur-sm transition-opacity" onclick="closeModalAnggaran()"></div>
        <div class="absolute inset-0 flex items-center justify-center p-4">
            <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md transform transition-all scale-100">
                <div class="p-6 border-b border-slate-100 flex justify-between items-center">
                    <h3 class="text-lg font-bold text-slate-900">Edit Anggaran</h3>
                    <button onclick="closeModalAnggaran()" class="text-slate-400 hover:text-slate-600 transition-colors">
                        <i class="fas fa-times text-xl"></i>
                    </button>
                </div>
                <div class="p-6 space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1">Kategori</label>
                        <input type="text" id="edit-kat" readonly class="w-full px-4 py-2.5 rounded-xl bg-slate-50 border border-slate-200 text-slate-600 cursor-not-allowed">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1">Nominal Anggaran (Rp)</label>
                        <input type="number" id="edit-nominal" required min="0" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 transition-all text-lg font-semibold">
                    </div>
                    <div class="bg-blue-50 rounded-xl p-4 flex items-start gap-3">
                        <i class="fas fa-info-circle text-blue-500 mt-0.5"></i>
                        <p class="text-sm text-blue-700">Perubahan anggaran akan mempengaruhi perhitungan sisa budget dan status kategori.</p>
                    </div>
                </div>
                <div class="p-6 border-t border-slate-100 flex gap-3">
                    <button onclick="closeModalAnggaran()" class="flex-1 px-4 py-2.5 rounded-xl border border-slate-200 text-slate-600 font-medium hover:bg-slate-50 transition-all">Batal</button>
                    <button onclick="saveAnggaran()" class="flex-1 px-4 py-2.5 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-semibold shadow-lg shadow-blue-200 hover:shadow-xl transition-all">
                        <i class="fas fa-save mr-2"></i>Simpan
                    </button>
                </div>
            </div>
        </div>
    </div>

</body>
</html>
